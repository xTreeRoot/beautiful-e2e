# Backend
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/beautiful_e2e?charset=utf8mb4
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
WORKSPACE_SCAN_MAX_FILES=160
AI_PROVIDER=codex_bridge
AI_PROVIDER_ENTRYPOINT=
AI_PROVIDER_CONFIG={}
AI_FALLBACK_RULE_BASED=true
AI_MODEL=gpt-5.5
AI_WIRE_API=responses
AI_REASONING_EFFORT=xhigh
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=3000
# Optional explicit OpenAI-compatible provider overrides. If omitted, codex_bridge
# falls back to OPENAI_* env vars or CODEX_HOME/~/.codex auth/config files.
AI_BASE_URL=
AI_API_KEY=
# Backward-compatible aliases still work when present:
# CODEX_BRIDGE_MODEL=gpt-5.5
# CODEX_BRIDGE_WIRE_API=responses
# CODEX_BRIDGE_REASONING_EFFORT=xhigh

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Runner
BASE_URL=http://localhost:5173
